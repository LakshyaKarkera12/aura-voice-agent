# Copy to .env.local and fill in real values. Never commit .env.local.
# VITE_ variables are visible in the browser. Only safe-to-share values may use that prefix.

# ── Supabase (browser-safe) ──
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Supabase (server, used by /api to verify the user's token) ──
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ── ElevenLabs (server only) ──
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# (No VITE_ agent ID: the browser gets a signed URL from /api/signed-url.)
# Optional: override the Gemini model (default is pinned in server/gemini.js)
# GEMINI_MODEL=

# ── Access control (server only) ──
# Optional comma-separated allow-list. If set, ONLY these accounts can start
# calls or get summaries; everyone else gets "not available". Empty = open.
# ALLOWED_EMAILS=you@example.com

# ── Google Gemini (server only) ──
GEMINI_API_KEY=

# ── Gmail API via Google Cloud OAuth (server only) — see docs/GMAIL_SETUP.md ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GMAIL_SENDER=
